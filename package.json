{
  "name": "food-delivery-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test": "npm run test:unit",
    "test:unit": "vue-cli-service test:unit --runInBand",
    "test:unit:watch": "vue-cli-service test:unit --watch",
    "test:e2e": "playwright test --project=chromium-live",
    "test:e2e:mock": "playwright test --project=chromium-mocked",
    "test:e2e:personas": "playwright test --project=chromium-personas",
    "test:e2e:install": "playwright install chromium",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.9",
    "core-js": "^3.8.3",
    "pinia": "^2.3.1",
    "vue": "^3.2.13",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.8",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^27.0.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.89.0",
    "sass-loader": "^13.3.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2021": true,
      "jest": true,
      "vue/setup-compiler-macros": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "ecmaVersion": 2021
    },
    "rules": {}
  },
  "jest": {
    "preset": "@vue/cli-plugin-unit-jest"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
