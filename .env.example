# Copy to `.env` (which is gitignored) and fill in.

# API base URL used by the frontend to make requests.
# In local dev leave this unset — the dev proxy forwards /api/* to VUE_APP_DEV_PROXY_TARGET
# and the app falls back to the relative `/api/v1`.
# In production set the full base URL, e.g. https://api.swaad.com/api/v1
VUE_APP_API_BASE_URL=

# Local dev proxy target. Requests to /api/* are forwarded here by the webpack dev server.
# Only takes effect during `npm run serve`; has no impact on production builds.
VUE_APP_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Sent as X-API-Key on POST /auth/init-session — the ONLY endpoint that reads it.
# Must match CLIENT_API_KEY on the backend. The backend's APIKeyMiddleware passes
# everything through when its own key is empty, so this may be left blank locally.
VUE_APP_CLIENT_API_KEY=dev-client-api-key

# Vue CLI built-in. Controls the base path for vue-router's history mode.
# Leave as / unless the app is served from a sub-path (e.g. /app/).
BASE_URL=/
